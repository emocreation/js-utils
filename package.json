{
  "name": "@emohk/utils",
  "version": "1.0.0",
  "description": "A collection of utility functions for various projects.",
  "type": "module",
  "module": "./dist/index.mjs",
  "main": "./dist/index.cjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/emocreation/js-utils.git"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "prettier": "^3.8.1",
    "typedoc": "^0.28.17",
    "typedoc-plugin-markdown": "^4.10.0"
  },
  "peerDependencies": {
    "typescript": "^5.9.3"
  },
  "scripts": {
    "build": "bun run build.ts",
    "declare": "tsc index.ts --declaration --emitDeclarationOnly --outDir dist",
    "docs": "typedoc",
    "prepublishOnly": "bun run build && bun run declare"
  },
  "author": "Ronald Mak",
  "license": "MIT"
}
